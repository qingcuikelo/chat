# ---- 应用 ----
APP_NAME=AI ChatBot
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173

# ---- 数据库 ----
# 开发（SQLite）
DATABASE_URL=sqlite+aiosqlite:///./aichat.db
# 生产（MySQL）：必须使用 utf8mb4，否则无法存储 emoji 等 4 字节字符
# DATABASE_URL=mysql+aiomysql://user:pass@localhost:3306/ai_chatbot?charset=utf8mb4
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL=1800
REDIS_REQUEST_TTL=600
REDIS_CACHE_TTL=3600

# ---- 认证与安全 ----
JWT_SECRET_KEY=change-me-to-a-random-32-byte-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_HASH_SCHEME=bcrypt
RATE_LIMIT_PER_MINUTE=20

# ---- LLM ----
LLM_API_KEY=sk-your-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_SYSTEM_PROMPT=你是一个乐于助人的 AI 助手。

# ---- 聊天上下文 ----
CHAT_CONTEXT_MAX_MESSAGES=20
CHAT_CONTEXT_MAX_TOKENS=8000
CHAT_STREAM_HEARTBEAT=15

# ---- 日志 ----
LOG_LEVEL=INFO
LOG_FORMAT=text
