# ---- 应用 ----
APP_NAME=AI ChatBot
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173
REQUEST_ID_HEADER=X-Request-ID

# ---- 数据库 ----
# 开发（SQLite）
DATABASE_URL=sqlite+aiosqlite:///./aichat.db
# 生产（MySQL）：必须使用 utf8mb4，否则无法存储 emoji 等 4 字节字符
# DATABASE_URL=mysql+aiomysql://user:pass@localhost:3306/ai_chatbot?charset=utf8mb4
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL=1800
REDIS_REQUEST_TTL=600
REDIS_CACHE_TTL=3600
REDIS_SOCKET_TIMEOUT=5
REDIS_MAX_CONNECTIONS=50

# ---- 后台任务（ARQ）----
# 留空则复用 REDIS_URL
ARQ_REDIS_URL=
SUMMARY_QUEUE_ENABLED=true

# ---- 认证与安全 ----
JWT_SECRET_KEY=change-me-to-a-random-32-byte-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_HASH_SCHEME=bcrypt
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_LOGIN_IP_PER_MINUTE=30
RATE_LIMIT_REGISTER_PER_MINUTE=3
RATE_LIMIT_REGISTER_IP_PER_MINUTE=10
RATE_LIMIT_REFRESH_PER_MINUTE=10
RATE_LIMIT_FAIL_MODE=open
RATE_LIMIT_TRUST_FORWARDED_HEADERS=false
RATE_LIMIT_CLIENT_IP_HEADER=X-Forwarded-For
TRUSTED_PROXIES=

# ---- LLM ----
LLM_API_KEY=sk-your-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2
LLM_SYSTEM_PROMPT=你是一个乐于助人的 AI 助手。
# 摘要专用模型（留空则沿用 LLM_MODEL）
LLM_SUMMARY_MODEL=
# 流式请求是否携带 stream_options.include_usage（不支持时自动降级）
LLM_STREAM_INCLUDE_USAGE=true

# ---- 聊天上下文 ----
CHAT_CONTEXT_MAX_MESSAGES=40
CHAT_CONTEXT_MAX_TOKENS=65536
CHAT_STREAM_HEARTBEAT=15

# ---- SSE delta 合批 ----
SSE_BATCH_MIN_CHARS=24
SSE_BATCH_MAX_INTERVAL_MS=50

# ---- token 计数 ----
# 留空用 CJK 感知启发式；填 tiktoken 编码名（如 cl100k_base）启用精确计数
TOKENIZER_ENCODING=

# ---- 上下文滚动摘要 ----
CHAT_SUMMARY_ENABLED=true
CHAT_SUMMARY_TRIGGER_RATIO=0.8
CHAT_SUMMARY_KEEP_RECENT_MESSAGES=20
CHAT_SUMMARY_MAX_TOKENS=2048

# ---- 日志 ----
LOG_LEVEL=INFO
LOG_FORMAT=text
